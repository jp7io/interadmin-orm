includes:
    - phpstan-baseline.neon

parameters:
    level: 1
    paths:
        - Jp7
    # Scanned, not executed: the ORM reaches Laravel through root-aliased facade names
    # that only exist inside a booted app, and polyfill.php is where the suite declares them.
    scanFiles:
        - tests/polyfill.php
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Provided by the host Laravel app at runtime, not by this package: root-aliased
        # facades and the \Date alias tests/bootstrap.php sets up for Carbon.
        -
            identifier: class.notFound
            message: '#\b(Storage|ImgResize|RecordUrl|Date)\b#'
        # Also runtime-only: Cache::tag() is a MACRO jp7io/classes registers (Cache::tags(),
        # the spelling that looks right, throws on every tenant), and RouterFacade proxies
        # Jp7\Laravel\Router::getRouteByTypeId() through the facade's __callStatic.
        -
            identifier: staticMethod.notFound
            message: '#\b(Cache::tag|RouterFacade::getRouteByTypeId)\(\)#'
    excludePaths:
        - vendor
