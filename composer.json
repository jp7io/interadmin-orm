{
    "name": "jp7io/interadmin-orm",
    "description": "JP7 InterAdmin ORM",
    "keywords": [],
    "license": "proprietary",
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:jp7io/classes"
        }
    ],
    "require": {
        "php": "^8.5",
        "jp7io/classes": "dev-eloquent-2026 as dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "InterAdmin\\Models\\": "InterAdmin/Models/"
        }
    },
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpunit"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "component-dir": "vendor/components-installed",
        "platform": {
            "php": "8.5"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
