{
    "name": "jp7io/interadmin-orm",
    "description": "JP7 InterAdmin ORM",
    "keywords": [],
    "license": "proprietary",
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:jp7io/classes"
        }
    ],
    "require": {
        "php": "^8.4",
        "jdorn/sql-formatter": "~1.2"
    },
    "require-dev": {
        "jp7io/classes": "dev-main",
        "illuminate/support": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/cache": "^12.0",
        "illuminate/config": "^12.0",
        "symfony/var-dumper": "^7.0",
        "phpunit/phpunit": "^12.5",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Jp7\\Interadmin\\": "Jp7/Interadmin/"
        },
        "classmap": [
            "legacy"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpunit"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "component-dir": "vendor/components-installed"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
