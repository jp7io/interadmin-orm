{
    "name": "jp7io/interadmin-orm",
    "description": "JP7 InterAdmin ORM",
    "keywords": [],
    "license": "proprietary",
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:jp7io/classes"
        }
    ],
    "require": {
        "php": "^8.5",
        "doctrine/sql-formatter": "^1.5"
    },
    "require-dev": {
        "jp7io/classes": "dev-main",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/cache": "^13.0",
        "illuminate/config": "^13.0",
        "illuminate/pagination": "^13.0",
        "symfony/var-dumper": "^8.1",
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.2",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Jp7\\Interadmin\\": "Jp7/Interadmin/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpunit"
        ],
        "analyse": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpstan analyse --memory-limit=1G"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "component-dir": "vendor/components-installed",
        "platform": {
            "php": "8.5"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
